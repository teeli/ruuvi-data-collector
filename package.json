{
  "name": "ruuvi-collector-v2",
  "version": "1.0.0",
  "description": "Collect measurements from RuuviTag & RuuviAir",
  "license": "MIT",
  "author": "Teemu Lahti",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "compile": "tsc",
    "start": "bun src/index.ts",
    "config:generate": "bun src/cli/commands/config-generate.ts",
    "watch": "bun --watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "1.35.0",
    "@logtape/file": "2.4.1",
    "@logtape/logtape": "2.4.1",
    "@logtape/redaction": "2.4.1",
    "@stoprocent/noble": "2.8.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.49.1",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "js-yaml": "5.4.3",
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint",
    "*.md": [
      "prettier --write",
      "markdownlint --fix"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ]
  }
}
